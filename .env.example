# Copy this file to .env and fill in real values. Never commit .env.

# App under test, e.g. https://your-app.example.com
BASE_URL=

# Test account used to log in
CIP_USER=
CIP_PASS=

# Expected profile card values for the test account
EXPECTED_NAME=
EXPECTED_INITIALS=
EXPECTED_ROLE=
# Optional: TC-440 is skipped when empty
EXPECTED_TENANT_ID=

# Extra accounts for "no permission" tests (TC-272, TC-350); skipped when empty
SUPERVISOR_USER=
SUPERVISOR_PASS=
AGENT_USER=
AGENT_PASS=

# Tests that change production data (roles, keywords, alert settings) only run
# when this is set to true. Leave it empty for normal runs.
ALLOW_WRITES=
